{
  "name": "nuxt-quasar-sample",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "npx prisma generate && nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "setup": "pnpm run db:init && pnpm run db:seed",
    "db:init": "cp .env.example .env && npx prisma generate && npx prisma migrate dev --name init",
    "db:seed": "npx prisma db seed",
    "studio": "npx prisma studio",
    "schema": "npx prisma generate"
  },
  "dependencies": {
    "@nuxt/content": "^2.12.1",
    "@quasar/extras": "^1.16.12",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "jsonwebtoken": "^9.0.2",
    "is-kit": "^1.8.1",
    "nuxt": "^4.0.3",
    "nuxt-quasar-ui": "^2.1.5",
    "quasar": "^2.15.3",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.0",
    "@nuxt/eslint-config": "^0.7.0",
    "@nuxtjs/html-validator": "^1.7.2",
    "@prisma/client": "^6.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.13",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prisma": "^6.5.0",
    "sass": "^1.75.0",
    "tslint-config-prettier": "^1.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --parser-options=project:./tsconfig.json --cache --fix"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
